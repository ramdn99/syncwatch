<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SyncWatch: Rust crate licenses</title>
<style>
body { background: #0b0b0d; color: #f2f2f4; font: 14px/1.5 sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
a { color: #6aa8f7; }
pre { white-space: pre-wrap; background: #141417; padding: 1rem; border-radius: 6px; }
h2 { margin-top: 2.5rem; }
</style>
</head>
<body>
<h1>Rust crates in SyncWatch and their licenses</h1>
<p>Generated by cargo-about for the release build. SyncWatch itself is licensed under the GPL-3.0.</p>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}} crates)</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
